{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "noEmit": true
  },
  "include": ["src/telegram/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "dist", "src/index.ts", "src/worker.ts", "src/cli", "src/mcp"]
}
