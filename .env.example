# Docling API (the docling-api Worker: https://github.com/EngDawood/docling)
# Copy this file to .env and fill in your values.

# Your deployed docling-api Worker
DOCLING_URL=https://docling-api.your-subdomain.workers.dev

# The API_KEY secret you set on that Worker
DOCLING_API_KEY=your_docling_api_key_here
