{
  "name": "mcp-mistral-ocr",
  "version": "2.0.0",
  "author": "Dawood (https://engdawood.com/)",
  "description": "MCP server, Telegram bot and CLI for documents, images and audio using your own Docling API on Cloudflare Containers",
  "type": "module",
  "bin": {
    "docling": "dist/cli/index.js",
    "ocr": "dist/cli/index.js",
    "docling-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:worker": "tsc --project tsconfig.worker.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "npm run build && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "docling",
    "ocr",
    "pdf",
    "docx",
    "pptx",
    "cli",
    "audio",
    "transcription",
    "whisper",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EngDawood/mcp-mistral-ocr.git"
  },
  "homepage": "https://github.com/EngDawood/mcp-mistral-ocr#readme",
  "bugs": {
    "url": "https://github.com/EngDawood/mcp-mistral-ocr/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.0.0",
    "agents": "^0.3.6",
    "typescript": "^5.7.0",
    "wrangler": "~4.105.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  }
}
